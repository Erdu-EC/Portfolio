---
import { personal } from '../config/personal'

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Proyectos', href: '/projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contacto', href: '/contact' },
]

const currentPath = Astro.url.pathname
---

<header class="sticky top-0 z-50 border-b border-gray-200 dark:border-gray-800/50 bg-white dark:bg-gray-950/90 backdrop-blur-lg shadow-sm">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-bold text-lg text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
      <span class="relative inline-block w-9 h-9 rounded-full bg-[#3f7ca5] shadow-sm overflow-hidden">
        <img
          src={personal.avatarSmall}
          alt={personal.fullName}
          class="w-full h-full object-cover object-center"
        />
      </span>
      <span>{personal.fullName}</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
            currentPath === item.href
              ? 'text-primary-600 dark:text-primary-300 bg-primary-50 dark:bg-primary-950/50'
              : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800'
          }`}
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Right side: GitHub + LinkedIn + Theme toggle + Mobile menu -->
    <div class="flex items-center gap-2">
      <!-- Social Icons -->
      <div class="flex items-center gap-1">
        <!-- GitHub Link -->
        <a
          href={personal.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <!-- LinkedIn Link -->
        <a
          href={personal.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
      <!-- Controls -->
      <div class="flex items-center gap-1 ml-2 pl-2 border-l border-gray-200 dark:border-gray-700/50">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="relative p-2 rounded-lg text-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors w-10 h-10 flex items-center justify-center"
          aria-label="Toggle theme"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="theme-icon-sun w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="theme-icon-moon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="Toggle menu"
        >
          <svg class="w-5 h-5 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-5 h-5 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="md:hidden border-t border-gray-200 dark:border-gray-800 overflow-hidden transition-all duration-300 ease-in-out max-h-0">
    <div class="px-4 py-3 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
            currentPath === item.href
              ? 'text-primary-600 dark:text-primary-300 bg-primary-50 dark:bg-primary-950/50'
              : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800'
          }`}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  let isOpen = false

  btn?.addEventListener('click', () => {
    isOpen = !isOpen
    if (isOpen) {
      menu?.classList.remove('max-h-0')
      menu?.classList.add('max-h-96')
      btn.querySelector('.menu-icon')?.classList.add('hidden')
      btn.querySelector('.close-icon')?.classList.remove('hidden')
    } else {
      menu?.classList.remove('max-h-96')
      menu?.classList.add('max-h-0')
      btn.querySelector('.menu-icon')?.classList.remove('hidden')
      btn.querySelector('.close-icon')?.classList.add('hidden')
    }
  })
</script>
