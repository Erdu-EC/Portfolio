---
import Analytics from '@vercel/analytics/astro'

import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {personal} from '../config/personal'

const {title, description} = Astro.props
---

<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description ?? personal.seo.defaultDescription}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <!-- Prevent dark mode flash on load -->
    <script is:inline>
        (function () {
            const stored = localStorage.getItem('theme')
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
            const isDark = stored === 'dark' || (!stored && prefersDark)
            if (isDark) {
                document.documentElement.classList.add('dark')
            }
            // Store preference for JS to read without re-evaluating
            window.__themeInit = isDark
        })()
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <!-- Preload critical font to avoid FOUT/FOIT -->
    <link rel="preload"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
          as="style"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
          rel="stylesheet"/>
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json"/>
    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.toString()}/>
    <meta name="generator" content={Astro.generator}/>
    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={Astro.url.toString()}/>
    <meta property="og:title" content={title ? `${title} — ${personal.fullName}` : personal.seo.defaultTitle}/>
    <meta property="og:description" content={description ?? personal.seo.ogDescription}/>
    <meta name="twitter:card" content="summary"/>
    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#4f46e5"/>
    <title>{title ? `${title} — ${personal.fullName}` : personal.seo.defaultTitle}</title>
    <!-- Structured Data: JSON-LD -->
    <script is:inline type="application/ld+json">
        {
            JSON.stringify(
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": personal.fullName,
                "url": personal.website,
                "jobTitle": personal.jobTitle,
                "description": personal.tagline,
                "sameAs": [
                    personal.social.github,
                    personal.social.linkedin
                ],
                "knowsAbout": personal.skills
            }
            )
        }
    </script>
</head>
<body>
<Header/>
<main>
    <slot/>
</main>
<Footer/>
<Analytics />

<!-- Scroll to Top Button -->
<button
        id="scroll-to-top"
        class="fixed bottom-6 right-6 z-50 p-3 rounded-full bg-primary-600 hover:bg-primary-700 text-white shadow-lg shadow-primary-500/25 transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
        aria-label="Volver arriba"
>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
    </svg>
</button>
</body>
</html>

<script is:inline>
    // Dark mode toggle with smooth transition
    const html = document.documentElement
    const toggle = document.getElementById('theme-toggle')

    function updateToggle() {
        const isDark = html.classList.contains('dark')
        if (toggle) {
            toggle.setAttribute('aria-label', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro')
        }
    }

    toggle?.addEventListener('click', () => {
        html.classList.toggle('dark')
        const isDark = html.classList.contains('dark')
        localStorage.setItem('theme', isDark ? 'dark' : 'light')

        // Use requestAnimationFrame to ensure the class change is processed
        requestAnimationFrame(() => {
            updateToggle()
        })
    })

    // Initialize from the pre-loaded value
    if (window.__themeInit === true) {
        html.classList.add('dark')
    }
    updateToggle()

    // Scroll to Top button
    const scrollBtn = document.getElementById('scroll-to-top')

    window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
            scrollBtn?.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none')
            scrollBtn?.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto')
        } else {
            scrollBtn?.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none')
            scrollBtn?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto')
        }
    }, {passive: true})

    scrollBtn?.addEventListener('click', () => {
        window.scrollTo({top: 0, behavior: 'smooth'})
    })
</script>
