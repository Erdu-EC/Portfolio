---
import Layout from '../layouts/Layout.astro'
import Skills from '../components/Skills.astro'
import ProjectCard from '../components/ProjectCard.astro'
import BlogPostCard from '../components/BlogPostCard.astro'
import { personal } from '../config/personal'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects', (entry) => entry.data.featured)
const blogPosts = await getCollection('blog', (entry) => !entry.data.draft)
  .then((posts) => posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3))

const skillCategories = [
  {
    name: 'Backend',
    icon: '⚙️',
    skills: ['.NET Core 6/8/10', 'C#', 'PHP 8', 'Python', 'Node.js', 'Entity Framework', 'Dapper', 'REST APIs', 'PowerShell'],
  },
  {
    name: 'Frontend',
    icon: '🎨',
    skills: ['TypeScript', 'JavaScript', 'React', 'Vue 3', 'Nuxt 4', 'Tailwind CSS', 'HTML5', 'CSS3', 'Tauri'],
  },
  {
    name: 'Bases de Datos',
    icon: '🗄️',
    skills: ['PostgreSQL', 'SQL Server', 'MySQL', 'Redis'],
  },
  {
    name: 'DevOps & Cloud',
    icon: '☁️',
    skills: ['Docker', 'Azure', 'GitHub Actions', 'CI/CD', 'NPM'],
  },
  {
    name: 'Herramientas & Desktop',
    icon: '🛠️',
    skills: ['CKEditor 5', 'Git', 'Visual Studio', 'VS Code', 'JetBrains Rider', 'Postman', 'OpenAPI'],
  },
  {
    name: 'Metodologías',
    icon: '📋',
    skills: ['Scrum', 'Liderazgo', 'Clean Architecture', 'Automatización', 'Cloud'],
  },
]
---

<Layout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-100 via-primary-50 to-blue-50 dark:from-gray-900 dark:via-primary-950/60 dark:to-gray-900" />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 relative">
      <div class="max-w-3xl animate-slide-up">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-100 dark:bg-primary-950/50 text-primary-700 dark:text-primary-300 text-sm font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse" />
          Disponible para nuevos proyectos
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white leading-tight mb-6">
          Hola, soy{' '}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-primary-400">
            {personal.fullName}
          </span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 leading-relaxed mb-8">
          {personal.tagline}
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-medium transition-colors shadow-lg shadow-primary-500/25"
          >
            Ver proyectos
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 font-medium transition-colors"
          >
            Contactar
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-20 bg-gray-100 dark:bg-gray-900/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Tecnologías</h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          Herramientas y tecnologías que utilizo para construir aplicaciones modernas y eficientes.
        </p>
      </div>
      <Skills categories={skillCategories} />
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-12">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Proyectos Destacados</h2>
          <p class="text-gray-600 dark:text-gray-400">
            Una selección de mis trabajos más recientes.
          </p>
        </div>
        <a
          href="/projects"
          class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Section -->
  <section class="py-20 bg-gray-100 dark:bg-gray-900/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-12">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Últimos Artículos</h2>
          <p class="text-gray-600 dark:text-gray-400">
            Reflexiones y tutoriales sobre desarrollo de software.
          </p>
        </div>
        <a
          href="/blog"
          class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {blogPosts.map((post) => (
          <BlogPostCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
        ¿Trabajamos juntos?
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
        Si tienes un proyecto en mente o simplemente quieres saludar, no dudes en contactarme.
        Siempre estoy abierto a nuevas oportunidades y colaboraciones.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-medium transition-colors shadow-lg shadow-primary-500/25"
      >
        Hablemos
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
