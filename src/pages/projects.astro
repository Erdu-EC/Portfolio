---
import Layout from '../layouts/Layout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { getCollection } from 'astro:content'

const allProjects = await getCollection('projects')
const featured = allProjects.filter((p) => p.data.featured)
const others = allProjects.filter((p) => !p.data.featured)

// Collect all tags
const allTags = new Set<string>()
allProjects.forEach((p) => p.data.tags.forEach((t) => allTags.add(t)))
const tags = Array.from(allTags).sort()

// Pass project data for client-side filtering
const projectsForClient = allProjects.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
  links: p.data.links,
  featured: p.data.featured,
  aiGenerated: p.data.aiGenerated,
}))
---

<Layout title="Proyectos">
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Proyectos</h1>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          Una colección de proyectos que he desarrollado, desde aplicaciones empresariales
          hasta herramientas open source.
        </p>
      </div>

      <!-- Tags Filter -->
      <div class="flex flex-wrap justify-center gap-2 mb-12" id="tag-filters">
        <button
          data-tag="all"
          class="tag-btn px-3 py-1 text-sm font-medium rounded-full cursor-pointer bg-primary-100 dark:bg-primary-900/50 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-800/50 transition-colors"
        >
          Todos
        </button>
        {tags.map((tag) => (
          <button
            data-tag={tag}
            class="tag-btn px-3 py-1 text-sm font-medium rounded-full cursor-pointer bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
          >
            {tag}
          </button>
        ))}
      </div>

      <!-- Featured -->
      {featured.length > 0 && (
        <div class="mb-12" id="featured-projects">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Destacados</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="featured-grid">
            {featured.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      )}

      <!-- Others -->
      {others.length > 0 && (
        <div id="other-projects">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Otros Proyectos</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="others-grid">
            {others.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<script is:inline>
  // Client-side tag filtering
  const projectsData = { projectsForClient }
  const tagButtons = document.querySelectorAll('.tag-btn')
  const featuredGrid = document.getElementById('featured-grid')
  const othersGrid = document.getElementById('others-grid')
  const featuredSection = document.getElementById('featured-projects')
  const othersSection = document.getElementById('other-projects')

  function renderProjects(projects, filterTag) {
    const filtered = filterTag === 'all'
      ? projects
      : projects.filter(p => p.tags.includes(filterTag))

    if (featuredGrid) {
      const featuredFiltered = filtered.filter(p => p.featured)
      featuredGrid.innerHTML = featuredFiltered.map(p => createProjectCardHTML(p)).join('')
      if (featuredSection) {
        featuredSection.style.display = featuredFiltered.length === 0 ? 'none' : ''
        const h2 = featuredSection?.querySelector('h2')
        if (h2) h2.textContent = filterTag === 'all' ? 'Destacados' : `Destacados (${filterTag})`
      }
    }

    if (othersGrid) {
      const othersFiltered = filtered.filter(p => !p.featured)
      othersGrid.innerHTML = othersFiltered.map(p => createProjectCardHTML(p)).join('')
      if (othersSection) {
        othersSection.style.display = othersFiltered.length === 0 ? 'none' : ''
      }
    }
  }

  function createProjectCardHTML(p) {
    let badgesHTML = ''
    if (p.featured || p.aiGenerated) {
      const badges = []
      if (p.featured) badges.push('<span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-700 dark:text-primary-300 border border-primary-200 dark:border-primary-800">⭐ Destacado</span>')
      if (p.aiGenerated) badges.push('<span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">✨ Generado por IA</span>')
      badgesHTML = '<div class="flex gap-2 mb-3">' + badges.join('') + '</div>'
    }

    const tagsHTML = p.tags.map(t => `<span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">${t}</span>`).join('')

    let linksHTML = ''
    if (p.links?.source) {
      linksHTML += `<a href="${p.links.source}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>Código</a>`
    }
    if (p.links?.demo) {
      linksHTML += `<a href="${p.links.demo}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>Demo</a>`
    }

    return `<article class="group relative p-6 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-300 hover:shadow-xl hover:shadow-primary-500/10 shadow-sm flex flex-col h-full">
      ${badgesHTML}
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">${p.title}</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-4 flex-grow">${p.description}</p>
      <div class="flex flex-wrap gap-2 mb-4">${tagsHTML}</div>
      <div class="flex gap-3 pt-4 border-t border-gray-100 dark:border-gray-800">${linksHTML}</div>
    </article>`
  }

  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag
      tagButtons.forEach(b => {
        b.classList.remove('bg-primary-100', 'dark:bg-primary-900/50', 'text-primary-700', 'dark:text-primary-300')
        b.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-400')
      })
      btn.classList.remove('bg-gray-100', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-400')
      btn.classList.add('bg-primary-100', 'dark:bg-primary-900/50', 'text-primary-700', 'dark:text-primary-300')
      renderProjects(projectsData, tag)
    })
  })
</script>
